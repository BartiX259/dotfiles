/* theme.rasi - Repurposed vertical image-header layout with base colors */

/*****----- Global Properties -----*****/
@theme "/dev/null"
@import "colors.rasi"

configuration {
    /* Core settings from target config */
    modi:                "drun";
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
    lazy-filter:         true;
    filter-lines:        8;
    drun-categories:     "AudioVideo,Audio,Video,Development,Education,Game,Graphics,Network,Office,Science,Settings,System,Utility";
    scroll-method:       0;
    click-to-exit:       true;
    cycle:               true;

    /* Mouse settings from base theme */
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    kb-cancel:           "Escape,MouseSecondary";
}

* {
    /* --- Font Settings --- */
    font:             "JetBrainsMono Nerd Font 13";
    margin:           0;
    padding:          0;
    spacing:          0;

    /* --- Color Mapping (From base theme) --- */
    background:     @surface;
    background-alt: @surface-container;
    foreground:     @on-surface;
    
    /* Using @primary for borders so the palette's true accent color shows up */
    accent:         @primary-fixed;       
    selected:       @primary-container;
    active:         @secondary-container;
    urgent:         @error;
}

/*****----- Main Window -----*****/
window {
    background-color:            @background;
    border:                      1px;
    border-color:                @accent;
    border-radius:               14px;
    width:                       560px;
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    background-color:            @background;
    spacing:                     0px;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar (Header with Image) -----*****/
inputbar {
    background-color:            transparent;
    background-image:            url("~/.cache/bgrofi.png", width);
    border-radius:               13px 13px 0px 0px;
    padding:                     0px;
    spacing:                     0px;
    orientation:                 vertical;
    children:                    [ "searchbar" ];
}

/* Container to push the search bar to the bottom of the image */
searchbar {
    background-color:            transparent;
    padding:                     100px 16px 16px 16px;
    spacing:                     8px;
    orientation:                 horizontal;
    children:                    [ "entry" ];
}

entry {
    enabled:                     true;
    placeholder:                 "Search";
    /* Hardcoded translucent colors here so they contrast against the background image */
    placeholder-color:           rgba(255,255,255,0.4);
    background-color:            rgba(0,0,0,0.60);
    text-color:                  #FFFFFF; 
    cursor:                      text;
    padding:                     12px 18px;
    border-radius:               8px;
    expand:                      true;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    fixed-height:                true;
    fixed-columns:               true;
    cycle:                       true;
    scrollbar:                   false;
    layout:                      vertical;
    
    spacing:                     0px;
    padding:                     8px 0px;
    background-color:            @background;
    border-radius:               0px 0px 13px 13px;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     16px 22px;
    spacing:                     14px;
    cursor:                      pointer;
    background-color:            transparent;
    border:                      0px;
    border-radius:               0px;
    orientation:                 horizontal;
    children:                    [ "element-icon", "element-text" ];
}

element normal.normal, element alternate.normal {
    background-color:            transparent;
    text-color:                  @foreground;
}

element normal.urgent {
    background-color:            transparent;
    text-color:                  @urgent;
}

element normal.active {
    background-color:            transparent;
    text-color:                  @active;
}

element selected.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
    /* 3px left border to clearly show the palette accent color */
    border:                      0px 0px 0px 3px;
    border-color:                @accent;
}

element selected.urgent {
    background-color:            @urgent;
    text-color:                  @background;
}

element selected.active {
    background-color:            @active;
    text-color:                  @background;
}

element-icon {
    size:                        22px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    background-color:            transparent;
    text-color:                  inherit;
}

/*****----- Message & Error -----*****/
message {
    background-color:            transparent;
}

textbox {
    padding:                     15px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     20px;
    background-color:            @background;
    text-color:                  @foreground;
    border:                      1px;
    border-color:                @accent;
    border-radius:               14px;
}
