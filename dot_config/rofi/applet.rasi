/* applet.rasi - For Scripts/Powermenus */

/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
    sort: true;
    sorting-method: "fzf";
}

/*****----- Import Library -----*****/
@import "theme.rasi"

/*****----- Overrides -----*****/
/* Applets usually have fewer items, so we shrink the list */

listview {
    lines: 6;
}

/* Optional: Change the placeholder text for the applet */
entry {
    placeholder: "Search";
}
element {
    /* 1. Remove the empty invisible icon gap from the layout */
    children: [ "element-text" ];
    
    /* 2. Match the exact padding from theme.rasi (22px on the left/right) 
          so the text-based icons align perfectly with the launcher icons */
    padding: 16px 22px;
}
