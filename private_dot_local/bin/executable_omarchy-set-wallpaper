#!/bin/sh

wall="$1"
cache_dir="$HOME/.cache/bgblur"
rofi_bg="$HOME/.cache/bgrofi.png"
blur_strength="0x8"

mkdir -p "$cache_dir"

if [ "$wall" = "--restore" ]; then
  wall=$(cat "$cache_dir/last")
fi

if [ ! -f "$wall" ]; then
  echo "No wallpaper $wall"
  exit
fi

if [ -f "$rofi_bg" ]; then
  rm $rofi_bg
fi

# 1. Set normal wallpaper
awww img "$wall" --transition-type wipe --transition-angle 30 --transition-duration 1 --transition-fps 60

# 2. Create unique cache file for this wallpaper (for blur)
filename="$(basename "$wall")"
blurred_cache="$cache_dir/${filename%.*}_blurred.${filename##*.}"

# Cache blurred wallpaper if missing or outdated
if [ ! -f "$blurred_cache" ] || [ "$wall" -nt "$blurred_cache" ]; then
  echo "Generating blurred cache for $filename..."
  magick convert "$wall" -blur "$blur_strength" "$blurred_cache"
fi

# Cache last selected
realpath $wall > "$cache_dir/last"

# 3. Set blurred wallpaper for overview
awww img "$blurred_cache" -n blur --transition-step 4 --transition-fps 60

# 4. Update colors
matugen image "$wall" --prefer less-saturation

# 5. Generate Rofi background
magick "$wall" -resize "560x200^" -gravity center -extent 560x200 "$rofi_bg"

